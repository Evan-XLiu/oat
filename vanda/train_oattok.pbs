#!/bin/bash
#PBS -N bimanual_tok
#PBS -j oe
#PBS -q auto_free
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=32:mpiprocs=1:ompthreads=32:mem=240gb:ngpus=1:gpu-type=nvidia

# This starter job uses Vanda's free tier because personal-xuanweiliu is not
# provisioned yet. Once a real project exists, remove `#PBS -q auto_free` and
# add `#PBS -P CFPxx-xx-nnn` using the exact identifier from `hpc project`.

set -euo pipefail

cd /scratch/xuanweiliu/bimanual_tokenizer/oat
source vanda/env.sh
module load msingularity

singularity exec --nv -e \
  --bind "${OAT_WORKSPACE}:${OAT_WORKSPACE}" \
  "${OAT_IMAGE}" \
  bash -lc "
    set -euo pipefail
    cd '${OAT_REPO}'
    export HYDRA_FULL_ERROR=1
    export WANDB_MODE='${WANDB_MODE}'
    export WANDB_DIR='${WANDB_DIR}'
    export HF_HOME='${HF_HOME}'
    export XDG_CACHE_HOME='${XDG_CACHE_HOME}'
    '${OAT_VENV}/bin/accelerate' launch \
      --num_machines 1 \
      --num_processes 1 \
      scripts/run_workspace.py \
      --config-name=train_oattok \
      task/tokenizer=libero/libero10 \
      training.num_demo=500
  "
